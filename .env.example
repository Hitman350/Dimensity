# ──────────────────────────────────────────────────
# Dimensity — Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────────────

# ── LLM Provider (pick ONE) ──────────────────────
GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=gemini               # "gemini" (default) | "openai" | "claude"
# MODEL_NAME=                        # optional model name override

# ── Database ─────────────────────────────────────
# Local (Docker Compose):
DATABASE_URL=postgresql://dimensity:localdevonly@localhost:5432/dimensity
# Production (AWS RDS):
# DATABASE_URL=postgresql://dimensity:<password>@dimensity.xxxxx.us-east-1.rds.amazonaws.com:5432/dimensity

# ── Auth ─────────────────────────────────────────
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ── Signer (development only — use a dedicated testnet key) ──
PRIVATE_KEY=0x_your_testnet_private_key

# ── Backend ──────────────────────────────────────
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# BACKEND_URL=http://127.0.0.1:4000  # Next.js → NestJS proxy target

# ── AWS (production only) ────────────────────────
# AWS_REGION=us-east-1
# AWS_SECRET_NAME=dimensity/prod     # SSM Parameter Store / Secrets Manager key
